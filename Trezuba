local function makeIcon(parent, kind)
    local holder = Instance.new("Frame")
    holder.Size = UDim2.new(0, 20, 0, 20)
    holder.BackgroundTransparency = 1
    holder.Parent = parent

    local function part(size, pos, radius, color)
        local f = Instance.new("Frame")
        f.Size = size
        f.Position = pos
        f.BackgroundColor3 = color or C_TEXT
        f.BorderSizePixel = 0
        f.Parent = holder
        if radius then Instance.new("UICorner", f).CornerRadius = radius end
        return f
    end

    if kind == "visual" then
        part(UDim2.new(0, 12, 0, 12), UDim2.new(0, 4, 0, 2), UDim.new(1, 0))
        part(UDim2.new(0, 14, 0, 4), UDim2.new(0, 3, 0, 16), UDim.new(1, 0))
        part(UDim2.new(0, 2, 0, 2), UDim2.new(0, 7, 0, 6), UDim.new(1, 0), C_BG)
        part(UDim2.new(0, 2, 0, 2), UDim2.new(0, 11, 0, 6), UDim.new(1, 0), C_BG)
    elseif kind == "esp" then
        part(UDim2.new(0, 18, 0, 12), UDim2.new(0, 1, 0, 4), UDim.new(1, 0))
        part(UDim2.new(0, 6, 0, 6), UDim2.new(0, 7, 0, 7), UDim.new(1, 0), C_BG)
        part(UDim2.new(0, 2, 0, 2), UDim2.new(0, 6, 0, 5), UDim.new(1, 0))
    elseif kind == "aim" then
        local ring = part(UDim2.new(0, 14, 0, 14), UDim2.new(0, 3, 0, 3), UDim.new(1, 0))
        ring.BackgroundTransparency = 1
        local s = Instance.new("UIStroke")
        s.Color = C_TEXT
        s.Thickness = 2
        s.Parent = ring
        part(UDim2.new(0, 3, 0, 3), UDim2.new(0, 8.5, 0, 8.5), UDim.new(1, 0))
        part(UDim2.new(0, 2, 0, 4), UDim2.new(0, 9, 0, 0), UDim.new(1, 0))
        part(UDim2.new(0, 2, 0, 4), UDim2.new(0, 9, 0, 16), UDim.new(1, 0))
        part(UDim2.new(0, 4, 0, 2), UDim2.new(0, 0, 0, 9), UDim.new(1, 0))
        part(UDim2.new(0, 4, 0, 2), UDim2.new(0, 16, 0, 9), UDim.new(1, 0))
    elseif kind == "fps" then
        part(UDim2.new(0, 14, 0, 3), UDim2.new(0, 2, 0, 3), UDim.new(1, 0))
        part(UDim2.new(0, 10, 0, 3), UDim2.new(0, 2, 0, 8.5), UDim.new(1, 0))
        part(UDim2.new(0, 6, 0, 3), UDim2.new(0, 2, 0, 14), UDim.new(1, 0))
        local tri = Instance.new("Frame")
        tri.Size = UDim2.new(0, 4, 0, 4)
        tri.Position = UDim2.new(0, 14, 0, 8)
        tri.BackgroundColor3 = C_TEXT
        tri.BorderSizePixel = 0
        tri.Rotation = 45
        tri.Parent = holder
    end
    return holder
end

