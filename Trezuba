local isOpen = false
local function setOpen(state)
    isOpen = state
    gui.Enabled = true
    if state then
        main.Visible = true
        toggleBtn.Text = "−"
        main.Size = UDim2.new(0, 0, 0, 0)
        main.Position = UDim2.new(0.5, 0, 0, 70)
        TweenService:Create(main, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
            Size = UDim2.new(0, 480, 0, 340),
            Position = UDim2.new(0.5, -240, 0, 70)
        }):Play()
    else
        toggleBtn.Text = "+"
        local t = TweenService:Create(main, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
            Size = UDim2.new(0, 0, 0, 0),
            Position = UDim2.new(0.5, 0, 0, 70)
        })
        t:Play()
        t.Completed:Connect(function()
            if not isOpen then gui.Enabled = false end
        end)
    end
end
toggleBtn.MouseButton1Click:Connect(function() setOpen(not isOpen) end)

