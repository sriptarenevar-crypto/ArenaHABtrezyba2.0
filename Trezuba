-- ================= ЛОГИКА: ESP =================
local espGui = Instance.new("ScreenGui")
espGui.Name = "ESP_Labels"
espGui.ResetOnSpawn = false
espGui.IgnoreGuiInset = true
espGui.Parent = localPlayer:WaitForChild("PlayerGui")
local espLabels = {}

local function createESPForPlayer(player)
    if player == localPlayer or espLabels[player] then return end
    local label = Instance.new("TextLabel")
    label.BackgroundTransparency = 1
    label.TextColor3 = Color3.new(1, 1, 1)
    label.TextStrokeTransparency = 0.3
    label.Font = Enum.Font.GothamBold
    label.TextSize = 12
    label.Visible = false
    label.Parent = espGui
    espLabels[player] = { label = label, highlight = nil }
end

local function removeESPForPlayer(player)
    if espLabels[player] then
        if espLabels[player].label then espLabels[player].label:Destroy() end
        if espLabels[player].highlight then espLabels[player].highlight:Destroy() end
        espLabels[player] = nil
    end
end

RunService.RenderStepped:Connect(function()
    if not settings.esp then
        for _, data in pairs(espLabels) do
            if data.label then data.label.Visible = false end
        end
        return
    end
    for player, data in pairs(espLabels) do
        local char = player.Character
        local head = char and char:FindFirstChild("Head")
        local humanoid = char and char:FindFirstChild("Humanoid")
        if not head or not humanoid or humanoid.Health <= 0 then
            data.label.Visible = false
            continue
        end
        local screenPos, onScreen = camera:WorldToViewportPoint(head.Position + Vector3.new(0, 1.5, 0))
        if not onScreen or screenPos.Z <= 0 then
            data.label.Visible = false
            continue
        end
        local text = player.Name
        if settings.espShowHealth then text = text .. " | HP: " .. math.floor(humanoid.Health) end
        if settings.espShowDistance then
            local dist = (head.Position - camera.CFrame.Position).Magnitude
            text = text .. " | " .. math.floor(dist) .. "m"
        end
        data.label.Text = text
        data.label.Position = UDim2.new(0, screenPos.X, 0, screenPos.Y - 20)
        data.label.Visible = true
    end
end)

local function syncESPHighlight(player)
    if player == localPlayer then return end
    local char = player.Character
    if not char then return end
    local data = espLabels[player]
    if not data then return end
    if settings.esp then
        if not data.highlight or not data.highlight.Parent then
            local h = Instance.new("Highlight")
            h.Name = "ESP_Highlight"
            h.Adornee = char
            h.FillColor = settings.espColor
            h.OutlineColor = settings.espOutline
            h.FillTransparency = 0.5
            h.OutlineTransparency = 0
            h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            h.Parent = char
            data.highlight = h
        else
            data.highlight.FillColor = settings.espColor
            data.highlight.OutlineColor = settings.espOutline
        end
    else
        if data.highlight and data.highlight.Parent then data.highlight:Destroy() end
        data.highlight = nil
    end
end

-- ================= AIMBOT =================
local function isTeammate(player)
    if not settings.teamCheck then return false end
    if not localPlayer.Team or not player.Team then return false end
    return localPlayer.Team == player.Team
end

local function getTarget()
    local closest = nil
    local shortest = settings.aimFOV
    local center = camera.ViewportSize / 2
    for _, player in ipairs(Players:GetPlayers()) do
        if player == localPlayer then continue end
        if isTeammate(player) then continue end
        local char = player.Character
        if not char then continue end
        local hum = char:FindFirstChild("Humanoid")
        if not hum or hum.Health <= 0 then continue end
        local part = char:FindFirstChild(settings.aimPart)
        if not part then continue end
        local screenPos, onScreen = camera:WorldToViewportPoint(part.Position)
        if not onScreen then continue end
        local dist = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
        if dist < shortest then
            shortest = dist
            closest = part
        end
    end
    return closest
end

local firingByTouch = false
UserInputService.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch then
        local vp = camera.ViewportSize
        local pos = input.Position
        if pos.X > vp.X * 0.6 and pos.Y > vp.Y * 0.5 then
            firingByTouch = true
        end
    end
end)
UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch then
        firingByTouch = false
    end
end)

RunService.RenderStepped:Connect(function(dt)
    if not settings.aimbot or not isUnlocked then return end
    if not (firingByTouch or UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1)) then return end
    local target = getTarget()
    if not target then return end
    local currentCF = camera.CFrame
    local targetCF = CFrame.new(currentCF.Position, target.Position)
    local alpha = 1 - math.clamp(settings.aimSmoothness, 0, 0.99)
    alpha = math.clamp(alpha * (dt * 60), 0, 1)
    camera.CFrame = currentCF:Lerp(targetCF, alpha)
end)

