                terrain.WaterWaveSpeed = 0
                terrain.WaterReflectance = 0
                terrain.WaterTransparency = 1
                terrain.Decoration = false
            end
        end)

        task.spawn(function()
            local count = 0
            for _, obj in ipairs(Workspace:GetDescendants()) do
                local isCharacterPart = false
                local parent = obj.Parent
                while parent do
                    if parent:IsA("Model") and parent:FindFirstChildOfClass("Humanoid") then
                        isCharacterPart = true
                        break
                    end
                    parent = parent.Parent
                end
                if not isCharacterPart then
                    if obj:IsA("BasePart") then
                        pcall(function()
                            obj.Material = Enum.Material.SmoothPlastic
                            obj.Reflectance = 0
                            obj.CastShadow = false
                        end)
                    elseif obj:IsA("Light") then
                        obj.Enabled = false
                    elseif obj:IsA("ParticleEmitter") or obj:IsA("Trail")
                    or obj:IsA("Beam") or obj:IsA("Fire")
                    or obj:IsA("Smoke") or obj:IsA("Sparkles") then
                        obj.Enabled = false
                    elseif obj:IsA("Decal") or obj:IsA("Texture") then
                        obj.Transparency = 1
                    end
                end
                count = count + 1
                if count % 300 == 0 then task.wait() end
            end
        end)

        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= localPlayer and p.Character then
                for _, acc in ipairs(p.Character:GetChildren()) do
                    if acc:IsA("Accessory") or acc:IsA("Hat") then
                        pcall(function() acc:Destroy() end)
                    end
                end
            end
        end
    end
end)

