local KEY_FILE = "ArenaHub_Keys.txt"

local function loadKeyData()
    local ok, data = pcall(function()
        if isfile and isfile(KEY_FILE) then return readfile(KEY_FILE) end
        return nil
    end)
    if ok and data and data ~= "" then
        local s, t = pcall(function()
            local out = {}
            for pair in string.gmatch(data, "([^;]+)") do
                local k, v = string.match(pair, "(.+)=(.+)")
                if k and v then out[k] = tonumber(v) end
            end
            return out
        end)
        if s then return t end
    end
    return {}
end

local function saveKeyData(data)
    pcall(function()
        local parts = {}
        for k, v in pairs(data) do table.insert(parts, k .. "=" .. tostring(v)) end
        writefile(KEY_FILE, table.concat(parts, ";"))
    end)
end

